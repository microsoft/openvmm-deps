# Microsoft Hypervisor root partition launched by the Linux EFI stub
CONFIG_HYPERV=y
CONFIG_MSHV_ROOT=y
CONFIG_X86_X2APIC=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y

# The shared test initrd does not install or load kernel modules
# CONFIG_MODULES is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Boot, networking, and file sharing under the outer VMM
CONFIG_PCI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
