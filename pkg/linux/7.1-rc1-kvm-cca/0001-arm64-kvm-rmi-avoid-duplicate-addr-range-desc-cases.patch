From: Will Wright <wwright@microsoft.com>
Subject: [PATCH] arm64: kvm: rmi: Avoid duplicate addr_range_desc cases

When the P4D level is folded, P4D_SIZE aliases PUD_SIZE. A switch over
the size therefore emits duplicate case labels when building configs with
folded P4Ds.

Use ordered comparisons instead, and prefer the concrete PUD encoding
when PUD_SIZE and P4D_SIZE are the same value.

--- a/arch/arm64/kvm/rmi.c
+++ b/arch/arm64/kvm/rmi.c
@@ -691,27 +691,22 @@
 {
 	unsigned long out = 0;
 
-	switch (size) {
-	case P4D_SIZE:
-		out = 3 | (1 << 2);
-		break;
-	case PUD_SIZE:
+	/* P4D_SIZE aliases PUD_SIZE when the P4D level is folded. */
+	if (size == PUD_SIZE) {
 		out = 2 | (1 << 2);
-		break;
-	case PMD_SIZE:
+	} else if (size == P4D_SIZE) {
+		out = 3 | (1 << 2);
+	} else if (size == PMD_SIZE) {
 		out = 1 | (1 << 2);
-		break;
-	case PAGE_SIZE:
+	} else if (size == PAGE_SIZE) {
 		out = 0 | (1 << 2);
-		break;
-	default:
+	} else {
 		/*
-		 * Only support mapping at the page level granulatity when
+		 * Only support mapping at the page level granularity when
 		 * it's an unusual length. This should get us back onto a larger
 		 * block size for the subsequent mappings.
 		 */
 		out = 0 | ((MIN(size >> PAGE_SHIFT, PTRS_PER_PTE - 1)) << 2);
-		break;
 	}
 
 	WARN_ON(phys & ~PAGE_MASK);
