# CCA L1 host and nested Realm support
CONFIG_KVM=y
CONFIG_KVM_GUEST_MEMFD=y
CONFIG_VIRT_DRIVERS=y
CONFIG_ARM_CCA_GUEST=y

# QEMU and FVP boot devices
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_NET_VENDOR_SMSC=y
CONFIG_SMC91X=y

# Petri agent transport
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Incubator rootfs and share
CONFIG_EXT4_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# Generic AArch64 TCG VFIO/P2P coverage
CONFIG_ZONE_DEVICE=y
CONFIG_PCI_P2PDMA=y
CONFIG_VFIO_DEVICE_CDEV=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_PCI_DMABUF=y
CONFIG_IOMMUFD=y
CONFIG_IOMMU_IOPF=y
CONFIG_ARM_SMMU_V3=y
CONFIG_ARM_SMMU_V3_SVA=y
CONFIG_ARM_SMMU_V3_IOMMUFD=y

# Reproducible, compatible address layout
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_LOCALVERSION_AUTO is not set
