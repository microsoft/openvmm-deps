# The SDK for building openvmm

# Security-related flags.
CFLAGS=-fstack-protector-strong -D_FORTIFY_SOURCE=2 -z noexecstack -fpic -Wl,-z,relro -Wl,-z,now -Wformat -Wformat-security -Werror=format-security -fstack-clash-protection
CXXFLAGS=$CFLAGS

# Optimize for size and omit unwind tables for more size, but retain frame pointers for debuggability.
CFLAGS=$CFLAGS -Os -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-omit-frame-pointer -g
CXXFLAGS=$CXXFLAGS -Os -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-omit-frame-pointer -g
    
pkg/libunwind
pkg/openssl3
pkg/symcrypt
pkg/ms_tpm_20_ref
pkg/ms_tcg_tpm_sys
pkg/mimalloc
